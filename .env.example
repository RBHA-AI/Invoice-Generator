# Copy to .env and fill in values (never commit .env)

# OpenAI — for AI-ranked HSN/SAC suggestions (optional; without it, keyword fallback is used)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com
HSN_SAC_LLM_TIMEOUT_MS=8000
# Optional longer timeout for email draft generation (milliseconds)
# EMAIL_LLM_TIMEOUT_MS=12000

# Path to official HSN/SAC master spreadsheet
HSN_SAC_XLSX_PATH=/home/admin1/Downloads/HSN_SAC.xlsx

# Set to 1 to import tax codes automatically when the server starts
AUTO_IMPORT_TAX_CODES=0

# Server
PORT=5000
# INVOICES_DB_PATH=/path/to/invoices.db

# Multi-tenant workspaces (required in production)
JWT_SECRET=uttamsinghamritendutiwari
ADMIN_SECRET=change-this-admin-secret-for-provisioning

# Default workspace (created on first boot; existing data is assigned here)
DEFAULT_WORKSPACE_SLUG=rbhargava
DEFAULT_WORKSPACE_DISPLAY_NAME=R Bhargava & Associates
DEFAULT_WORKSPACE_PASSWORD=changeme

# Email settings & send log (separate from invoices.db — does not modify invoice data)
# EMAIL_DB_PATH=/path/to/email.db

# Email — SMTP (recommended when DNS is not under your control)
EMAIL_PROVIDER=smtp
MAIL_FROM=amritendu@rbhargaassociates.com
MAIL_FROM_NAME=R Bhargava & Associates

SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=amritendu@rbhargaassociates.com
SMTP_PASS=your-app-password-here

# Email — Resend (optional; requires domain DNS verification)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_api_key_here
